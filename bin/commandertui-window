#!/usr/bin/env bash
# Opens CommanderTUI in its own foot window with app-id "commandertui", so a
# Hyprland window rule can float/center/size it.
SOURCE_FILE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE_FILE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE_FILE")" && pwd)"
    SOURCE_FILE="$(readlink "$SOURCE_FILE")"
    [[ $SOURCE_FILE != /* ]] && SOURCE_FILE="$DIR/$SOURCE_FILE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE_FILE")" && pwd)"

exec foot --app-id=commandertui --title=CommanderTUI "${BIN_DIR}/commandertui" "$@"

#!/usr/bin/env bash
# Run from a source checkout: uses the checkout's .venv when present.
# (Installed copies get their own `commandertui` entry point instead.)
SOURCE_FILE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE_FILE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE_FILE")" && pwd)"
    SOURCE_FILE="$(readlink "$SOURCE_FILE")"
    [[ $SOURCE_FILE != /* ]] && SOURCE_FILE="$DIR/$SOURCE_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_FILE")/.." && pwd)"

PY="python3"
[ -x "${SCRIPT_DIR}/.venv/bin/python3" ] && PY="${SCRIPT_DIR}/.venv/bin/python3"
export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}"

exec "$PY" -m commandertui.cli "$@"
